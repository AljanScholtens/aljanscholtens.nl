{{- /* Full-text RSS of the blog, for feed readers and AI tools.
       The home page feed and the blog feed both list the blog posts. */ -}}
{{- $pages := where site.RegularPages "Section" "blog" -}}
{{- if eq .Kind "section" }}{{ $pages = .RegularPages }}{{ end -}}
{{- $pages = first 20 $pages.ByDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Home.Description }}</description>
    <language>{{ site.Language.Name }}</language>
    <managingEditor>aljan@scholtens.me (Aljan Scholtens)</managingEditor>
    {{- with $pages }}
    <lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ replace .Title "&shy;" "" | plainify | htmlUnescape }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <author>aljan@scholtens.me (Aljan Scholtens)</author>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Content | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
